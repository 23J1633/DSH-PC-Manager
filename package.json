{
  "name": "dsh-pc-manager",
  "version": "1.0.0",
  "description": "AI computer manager powered by DeepSeek Harness",
  "keywords": [
    "electron",
    "react",
    "typescript",
    "vite",
    "windows",
    "desktop-app",
    "ai",
    "deepseek",
    "deepseek-harness",
    "computer-manager",
    "disk-cleaner",
    "virus-scanner",
    "privacy",
    "cybersecurity"
  ],
  "private": true,
  "type": "module",
  "main": "dist-electron/src/main/main.js",
  "author": "DSH PC Manager",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-dsh-windows.cjs",
    "prebuild": "node scripts/patch-dsh-windows.cjs",
    "dev": "npm run build && electron .",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "start": "npm run build && electron .",
    "test": "vitest run tests/result-parser.test.ts tests/connection-test.test.ts tests/path-suggestions.test.ts tests/history-store.test.ts tests/dsh-windows-patch.test.ts tests/markdown-render.test.tsx",
    "test:integration": "vitest run tests/dsh-runtime.integration.test.ts",
    "test:hidden-window": "node scripts/hidden-window-smoke.cjs",
    "test:shortcut": "electron scripts/shortcut-smoke.cjs",
    "test:settings": "npm run build && electron scripts/settings-smoke.cjs",
    "test:watch": "vitest",
    "typecheck": "tsc -b --pretty false",
    "icon:render": "electron scripts/render-icon.cjs",
    "package": "set \"ELECTRON_BUILDER_CACHE=%CD%\\.electron-builder-cache\" && npm run build && electron-builder",
    "package:dir": "set \"ELECTRON_BUILDER_CACHE=%CD%\\.electron-builder-cache\" && npm run build && electron-builder --dir"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.1",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^44.4.1",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "build": {
    "appId": "com.dsh.pcmanager",
    "productName": "DSH PC Manager",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/dsh",
        "to": "dsh"
      }
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "DSH-PC-Manager-${version}-Setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "DSH PC Manager"
    }
  }
}
